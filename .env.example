# Variables de entorno para desarrollo local.
# Uso: copiar este archivo como .env (cp .env.example .env) antes de `docker compose up -d`.
# El archivo .env esta en .gitignore: nunca se sube al repositorio.
# Los valores de abajo son SOLO para desarrollo local; en Render se configuran como
# variables de entorno del servicio, con valores distintos.

POSTGRES_PASSWORD=identityhub_dev_password
KEYCLOAK_ADMIN_PASSWORD=admin
# Debe coincidir con el secret del cliente "auth-proxy" en keycloak-realm/identityhub-realm.json
PROXY_CLIENT_SECRET=auth-proxy-dev-secret-cambiar-en-produccion
BACKEND_SERVICE_PASSWORD=clave-de-servicio-cambiar
