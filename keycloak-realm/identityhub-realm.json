{
  "realm": "identityhub",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin-ti",
        "description": "Administrador de TI: puede entrar al panel del inventario y ejecutar offboarding."
      }
    ]
  },
  "clients": [
    {
      "clientId": "auth-proxy",
      "name": "IdentityHub Auth Reverse Proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9000/auth/callback",
        "http://localhost:9100/auth/callback",
        "https://identityhub-gateway.onrender.com/auth/callback",
        "https://identityhub-panel.onrender.com/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:9000",
        "http://localhost:9100",
        "https://identityhub-gateway.onrender.com",
        "https://identityhub-panel.onrender.com"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:9000/login##http://localhost:9100/login##https://identityhub-gateway.onrender.com/login##https://identityhub-panel.onrender.com/login"
      }
    }
  ],
  "users": [
    {
      "username": "ana.torres",
      "email": "ana.torres@empresa-ejemplo.com",
      "firstName": "Ana",
      "lastName": "Torres",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${UAT_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin-ti"
      ]
    }
  ]
}
